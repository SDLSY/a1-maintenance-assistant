# Copy this file to .env.local and fill in real keys locally.
# Do not commit or share .env.local.

# Backward-compatible fallback. Role routes below decide the real runtime split.
MODEL_PROFILE=current
ACTIVE_MODEL_PROVIDER=codex
CORS_ALLOWED_ORIGINS=*
A1_DB_PATH=data/maintenance.db

# Optional cloud demo bootstrap. Useful for free hosts with ephemeral disks.
# It rebuilds the reviewed demo case/eval assets on startup without committing a runtime DB.
A1_DEMO_BOOTSTRAP_ON_STARTUP=false
A1_DEMO_EXP_CASE_COUNT=121
A1_DEMO_EXP_EVAL_COUNT=100
A1_DEMO_REBUILD_INDEX_ON_STARTUP=false

# Optional public deployment persistence.
# Keep service-role keys on the backend only. Never put them into Cloudflare Pages frontend variables.
SUPABASE_ENABLED=false
SUPABASE_URL=
# Legacy frontend-style URL name from Supabase/Next projects is also supported.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer a backend-only Supabase secret key when available.
SUPABASE_SECRET_KEY=
# Legacy service-role key name is also supported.
SUPABASE_SERVICE_ROLE_KEY=
# Anon keys are only for browser clients; they do not enable backend sync.
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TABLE_PREFIX=a1_
SUPABASE_SYNC_ON_STARTUP=true

# SpatialAI Codex/OpenAI-compatible endpoint.
# OPENAI_* is kept as a compatibility alias for Codex-style clients.
OPENAI_BASE_URL=https://spatialai.vip/v1
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=
CODEX_BASE_URL=https://spatialai.vip/v1
CODEX_API_KEY=
CODEX_TEXT_MODEL=gpt-5.5
CODEX_VISION_MODEL=gpt-5.5
CODEX_EMBEDDING_MODEL=

# OpenRouter embedding endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# OpenCode / Zen / Codex-style OpenAI-compatible relay.
# These model ids were validated against https://opencode.ai/zen/go/v1 in this workspace.
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_TEXT_MODEL=qwen3.6-plus
OPENCODE_VISION_MODEL=mimo-v2-omni
OPENCODE_EMBEDDING_MODEL=

# SpatialAI / Claude / Anthropic-compatible relay.
ANTHROPIC_BASE_URL=https://spatialai.vip
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-4-6

# Agent role routing.
# Two profile presets are kept in config/model_profiles.json:
#   python scripts/apply_model_profile.py current
#   python scripts/apply_model_profile.py china
#
# current = Codex/SpatialAI + OpenRouter embedding, optimized for stable demonstration.
# china   = OpenCode/OpenRouter gateway with domestic models: Qwen/Mimo/Qwen embedding.
# Recommended with the keys currently provided:
# - Codex/SpatialAI: validated text model calls.
# - Codex/SpatialAI: validated vision model calls with normal-sized images.
# - OpenRouter: validated embedding route candidate.
# - Local: deterministic hash embedding fallback.
# - Claude/SpatialAI: model listing works, but direct HTTP generation may be client-restricted by the relay.
TEXT_AGENT_PROVIDER=codex
TEXT_AGENT_MODEL=gpt-5.5
VISION_AGENT_PROVIDER=codex
VISION_AGENT_MODEL=gpt-5.5
EMBEDDING_AGENT_PROVIDER=openrouter
EMBEDDING_AGENT_MODEL=qwen/qwen3-embedding-8b
COMPLIANCE_AGENT_PROVIDER=codex
COMPLIANCE_AGENT_MODEL=gpt-5.5
KNOWLEDGE_AGENT_PROVIDER=codex
KNOWLEDGE_AGENT_MODEL=gpt-5.5
